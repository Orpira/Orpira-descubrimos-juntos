---
import Base from '../../layouts/Base.astro';
import { adventures, type Adventure } from '../../content';
import QRCode from 'qrcode';

export function getStaticPaths() {
  return adventures.map(item => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props as { item: Adventure };
const qr = Astro.site ? await QRCode.toDataURL(new URL(Astro.url.pathname, Astro.site).href, { width: 200 }) : null;
const related = adventures.filter(other => other.mundo === item.mundo && other.slug !== item.slug);
---
<Base title={item.titulo} description={item.resumen} image={'/arte/' + item.icono + '.webp'}>
<article class="narrow" id="adventure" data-slug={item.slug} data-version={item.version}>
  <a class="no-print" href="/#aventuras">← Todas las aventuras</a>
  <p class="eyebrow">{item.mundo}</p><h1>{item.titulo}</h1>
  <p>{item.resumen}</p><p class="meta">{item.edad.join('–')} años · {item.minutos} min · {item.nivel} · {item.personas.join('–')} personas</p>
  <img class="detail-image" src={'/arte/' + item.icono + '.webp'} alt="" width="720" height="420" />
  <section class="panel"><h2>La misión</h2><p>{item.mision}</p><p><strong>Lo que aprenderán.</strong> {item.objetivo}</p></section>
  <section class="panel"><h2>Materiales</h2><ul>{item.materiales.map((material, index) => <li>{material} · {item.cantidades[index]}</li>)}</ul><p>{item.alternativa}</p><p>{item.coste}</p><p><strong>Antes de empezar.</strong> {item.seguridad}</p></section>
  <section class="panel"><h2>Paso a paso</h2>
    <ol class="steps">{item.pasos.map((step, index) => <li><label><input type="checkbox" data-step={index} /> <span>{step}</span></label></li>)}</ol>
    <div class="buttons no-print">
      <button id="save-progress" type="button" aria-pressed="false">Guardar pasos en este dispositivo</button>
      <button id="reset-steps" type="button" class="secondary">Reiniciar pasos</button>
      <button id="listen" type="button" class="secondary" hidden>Escuchar pasos</button>
    </div>
  </section>
  <section class="panel"><h2>Después de la aventura</h2><p>{item.reflexion}</p><p><strong>Profesiones relacionadas.</strong> {item.profesiones.join(' · ')}</p><p><strong>Adaptación accesible.</strong> {item.accesibilidad}</p><p><strong>En grupo.</strong> {item.grupo}</p><p><strong>En el aula.</strong> {item.aula}</p><p><a href={item.fuente}>Referencia educativa</a></p></section>
  {qr && <figure><img class="qr" src={qr} alt={'QR de acceso a ' + item.titulo} /><figcaption>Abre la ficha con la cámara.</figcaption></figure>}
  <div class="buttons no-print">
    <button id="favorite" class="secondary" aria-pressed="false">Guardar favorito</button>
    <button id="completed" class="secondary" aria-pressed="false">Añadir sello al pasaporte</button>
    <button id="download" class="secondary" aria-pressed="false">Guardar sin conexión</button>
    <button id="print" class="secondary">Imprimir ficha</button>
    <button id="share" class="secondary">Compartir ficha</button>
  </div>
  <p class="status no-print" id="status" role="status"></p>
  {related.length > 0 && <aside class="no-print"><h2>Sigue explorando</h2><ul>{related.map(other => <li><a href={'/aventuras/' + other.slug + '/'}>{other.titulo}</a></li>)}</ul></aside>}
</article>
</Base>
<script>
import { bindAdventure } from '../../interactions';
bindAdventure();
</script>
